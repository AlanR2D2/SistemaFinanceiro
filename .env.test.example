# Credenciais para os testes E2E.
# Copie este arquivo para .env.test e preencha com os valores reais.
# .env.test NÃO é versionado (está no .gitignore).
#
# IMPORTANTE: o usuário abaixo DEVE pertencer ao tenant "Lara's Company".
# Os testes recusam rodar contra outros tenants — é a barreira de segurança
# principal para não impactar Dra Consumidor / Aeroline / etc.

# URL do Flask local rodando
TEST_BASE_URL=http://localhost:5001

# Credenciais de um usuário que pertence ao tenant Lara's Company
TEST_USER_LOGIN=usuario_lara
TEST_USER_PASSWORD=senha_aqui

# Nome exato do tenant (case-sensitive — bate com fin_tenants.nome).
# Se diferir do que está no banco, a suite aborta no primeiro teste.
TEST_TENANT_NAME=Lara's Company

# Prefixo aplicado em TODO recurso criado pelos testes (campos, opções).
# Permite ao teardown identificar e limpar só o que ele criou —
# evita apagar dados reais por engano.
TEST_RESOURCE_PREFIX=__E2E__
